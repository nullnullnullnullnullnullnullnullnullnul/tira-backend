# Application server
PORT=3000

# Application database connection (used by src/db/index.ts via pg.Pool)
DB_USER=tira
DB_PASS=tira
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tira_db

# Optional pool tuning (defaults shown)
# DB_POOL_MAX=10
# DB_POOL_MIN=2
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=10000

# Superuser credentials used by scripts/setup_db.sh and src/scripts/prep.ts
# to drop and recreate the database in development.
DB_SUPERUSER=postgres
DB_SUPERPASS=postgres

# Used by node-pg-migrate (npm run db:migrate). Must match the DB_* values
# above. node-pg-migrate reads it directly from this file via dotenv.
DATABASE_URL=postgres://tira:tira@localhost:5432/tira_db
