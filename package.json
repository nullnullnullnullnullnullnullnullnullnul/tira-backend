{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "dev": "cross-env DB_PORT=5432 bash scripts/setup_db.sh && cross-env DB_PORT=5432 ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p .",
    "start": "cross-env DB_PORT=5432 ts-node src/index.ts",
    "db:init": "cross-env DB_PORT=5432 bash scripts/setup_db.sh && npm run db:reset",
    "db:reset": "cross-env DB_PORT=5432 ts-node src/scripts/prep.ts && npm run db:migrate && npm run db:seed",
    "db:start": "pg_ctl -D .postgres_data -l postgres.log -o \"-p 5432 -k /tmp\" start",
    "db:stop": "pg_ctl -D .postgres_data stop",
    "db:migrate": "node-pg-migrate -m migrations -j sql up",
    "db:migrate:down": "node-pg-migrate -m migrations -j sql down",
    "db:migrate:create": "node-pg-migrate -m migrations -j sql create",
    "db:seed": "cross-env DB_PORT=5432 ts-node src/scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/yamljs": "^0.2.34",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "i": "^0.3.7",
    "pg": "^8.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ulid": "^3.0.1",
    "yaml": "^2.8.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.0.0",
    "jest": "^30.1.3",
    "node-pg-migrate": "^8.0.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
